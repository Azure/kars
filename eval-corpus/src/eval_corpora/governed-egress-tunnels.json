{
  "schemaVersion": "v1",
  "name": "governed-egress-tunnels",
  "cases": [
    {
      "id": "governed-egress-001-link-local",
      "tags": [
        "egress",
        "imds",
        "finite-budget"
      ],
      "scenario": {
        "kind": "EgressConnect",
        "host": "169.254.169.254",
        "port": 80
      },
      "expect": {
        "decision": "Blocked",
        "reasonContains": "Opaque tunnels are unsupported for governed inference; use mediated router APIs"
      }
    },
