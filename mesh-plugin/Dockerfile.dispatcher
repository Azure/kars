FROM node:22-bookworm-slim AS build
WORKDIR /build
COPY vendor/agt/*.tgz vendor/agt/SHA256SUMS ./vendor/agt/
COPY mesh-plugin/package.json mesh-plugin/package-lock.json mesh-plugin/tsconfig.json mesh-plugin/openclaw.plugin.json ./mesh-plugin/
COPY mesh-plugin/src ./mesh-plugin/src
COPY mesh-plugin/skills ./mesh-plugin/skills
RUN cd vendor/agt && sha256sum -c SHA256SUMS
WORKDIR /build/mesh-plugin
RUN --mount=type=cache,id=kars-mission-dispatcher-npm,target=/root/.npm \
    --mount=type=secret,id=npmrc,target=/root/.npmrc \
    npm ci --ignore-scripts --prefer-offline --no-audit --no-fund && \
    npm run build && npm prune --omit=dev --ignore-scripts --no-audit --no-fund

FROM mcr.microsoft.com/azurelinux/distroless/base:3.0 AS runtime-base

# Export the complete Microsoft libstdc++ RPM payload and retain the base inventory.
FROM mcr.microsoft.com/azurelinux/base/core:3.0 AS runtime-libs
COPY --from=runtime-base /var/lib/rpmmanifest/ /runtime-libs/var/lib/rpmmanifest/
RUN set -eu; \
    rpm -V libstdc++; \
    grep -Fx "$(rpm -q libgcc)" /runtime-libs/var/lib/rpmmanifest/container-manifest-1; \
    glibc_prefix="$(rpm -q --qf '%{NAME}-%{VERSION}-' glibc)"; \
    glibc_arch="$(rpm -q --qf '%{ARCH}' glibc)"; \
    matches=0; \
    while IFS= read -r package; do \
      case "$package" in "$glibc_prefix"?*".$glibc_arch") matches=$((matches + 1));; esac; \
    done < /runtime-libs/var/lib/rpmmanifest/container-manifest-1; \
    [ "$matches" -eq 1 ]; \
    rpm -ql libstdc++ > /package-files; \
    while IFS= read -r path; do \
      if [ -d "$path" ]; then \
        mkdir -p "/runtime-libs$(readlink -f "$path")"; \
      else \
        directory="$(readlink -f "$(dirname "$path")")"; \
        mkdir -p "/runtime-libs$directory"; \
        cp -a "$path" "/runtime-libs$directory/"; \
      fi; \
    done < /package-files; \
    rpm -q libstdc++ >> /runtime-libs/var/lib/rpmmanifest/container-manifest-1; \
    rpm -q --qf '%{NAME}\t%{VERSION}-%{RELEASE}\t%{INSTALLTIME}\t%{BUILDTIME}\t%{VENDOR}\t%{EPOCH}\t%{SIZE}\t%{ARCH}\t%{EPOCHNUM}\t%{SOURCERPM}\n' libstdc++ \
      >> /runtime-libs/var/lib/rpmmanifest/container-manifest-2

FROM runtime-base AS runtime
ENV NODE_ENV=production PATH=/usr/local/bin HOME=/home/node LD_BIND_NOW=1
ENV NODE_EXTRA_CA_CERTS=/etc/pki/tls/certs/ca-bundle.crt SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt
WORKDIR /opt/kars-mission-dispatcher
COPY --from=runtime-libs /runtime-libs/ /
COPY --from=build /usr/local/bin/node /usr/local/bin/node
COPY --from=build /usr/local/LICENSE /usr/local/share/licenses/node/LICENSE
COPY --from=build /build/mesh-plugin/package.json ./package.json
COPY --from=build /build/mesh-plugin/dist ./dist
COPY --from=build /build/mesh-plugin/node_modules ./node_modules
RUN ["node", "-e", "const fs = require('node:fs'); if (process.versions.node.split('.')[0] !== '22') throw new Error('Node22 required'); require('node:tls').createSecureContext({ ca: fs.readFileSync(process.env.NODE_EXTRA_CA_CERTS) }); fs.appendFileSync('/etc/passwd', 'node:x:1000:1000::/home/node:/sbin/nologin\\n'); fs.appendFileSync('/etc/group', 'node:x:1000:\\n'); fs.mkdirSync('/home/node', { recursive: true }); fs.chownSync('/home/node', 1000, 1000);"]
USER 1000:1000
RUN ["node", "--input-type=module", "-e", "import assert from 'node:assert/strict'; import * as sdk from '@microsoft/agent-governance-sdk'; import { missionProcessConfig } from './dist/mission-config.js'; assert.equal(process.getuid(), 1000); assert.equal(process.getgid(), 1000); const encryption = sdk.encryption ?? sdk; assert.equal(typeof encryption.MeshClient, 'function'); assert.equal(typeof encryption.X3DHKeyManager, 'function'); assert.throws(() => missionProcessConfig({}), { message: 'Mission dispatcher requires explicit development or entra authentication' });"]
EXPOSE 8080
ENTRYPOINT []
CMD ["node", "dist/mission-main.js"]
