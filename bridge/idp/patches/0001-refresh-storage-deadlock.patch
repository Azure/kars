+// PreparePasswordDBRefresh reads the built-in password database before a refresh
+// token transaction starts. The returned callback defers consumption of both the
+// identity and error until rotation actually needs them. Other connectors return
+// nil: their Refresh call must remain inside rotation's claim/reuse checks to
+// avoid consuming an upstream refresh token more than once.
+func PreparePasswordDBRefresh(ctx context.Context, conn connector.Connector, scopes connector.Scopes, identity connector.Identity) func() (connector.Identity, error) {
+	db, ok := conn.(passwordDB)
+	if !ok {
+		return nil
+	}
+	refreshed, err := db.Refresh(ctx, scopes, identity)
+	return func() (connector.Identity, error) {
+		return refreshed, err
+	}
+}
