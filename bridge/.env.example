# kars Bridge local configuration. Copy to .env and adjust as needed.
# Never commit real secrets.

# --- BFF ---
BRIDGE_BFF_PORT=8081
BRIDGE_WEB_ORIGIN=http://localhost:3000
BRIDGE_LOG_JSON=false

# Optional out-of-band receipt pins; leave unset rather than assigning empty values.
# BRIDGE_RECEIPT_ANCHOR_KEY_ID=<full lowercase SHA-256 fingerprint of raw public key>
# BRIDGE_RECEIPT_ANCHOR_PUBKEY=<standard base64 of 32-byte Ed25519 public key>

# --- Web (server-side) ---
BRIDGE_BFF_URL=http://localhost:8081
