# Rust (BFF)
/bff/target/
**/*.rs.bk
!/bff/Cargo.lock

# Node / Next.js (web)
node_modules
/web/.next/
/web/out/
/web/next-env.d.ts
!/web/src/app/workspace/artifacts/
!/web/src/app/workspace/artifacts/**

# Env & secrets — never commit
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/
*.log

# Disposable native qualification credentials, builds, and evidence
/.native/
