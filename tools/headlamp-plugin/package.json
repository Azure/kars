{
  "name": "kars",
  "version": "0.7.6",
  "private": true,
  "description": "kars sidebar + CRD views for the Headlamp dashboard.",
  "license": "MIT",
  "scripts": {
    "build": "headlamp-plugin build",
    "start": "headlamp-plugin start",
    "postinstall": "node patch-build-tool.mjs",
    "test": "node --test patch-build-tool.test.mjs && vitest run --config vitest.config.mts",
    "lint": "headlamp-plugin lint",
    "format": "headlamp-plugin format"
  },
  "headlampPlugin": {
    "displayName": "kars"
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "^0.13.0",
    "fork-ts-checker-webpack-plugin": "file:checker/fork-ts-checker-webpack-plugin-8.0.0-kars.tgz",
    "vite": "6.4.5"
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "14.0.2"
    },
    "quick-temp": {
      "rimraf": {
        "glob": "14.0.2"
      }
    },
    "minimatch@^10.0.0 || ^11.0.0": "11.0.1",
    "@storybook/builder-webpack5": {
      "fork-ts-checker-webpack-plugin": "$fork-ts-checker-webpack-plugin",
      "webpack-dev-middleware": "7.4.6"
    },
    "vitest": "4.1.12",
    "@vitest/coverage-istanbul": "4.1.12",
    "@vitest/mocker": "4.1.12",
    "tmp": "^0.2.6",
    "js-yaml": "4.3.2",
    "storybook": "9.1.21"
  }
}
